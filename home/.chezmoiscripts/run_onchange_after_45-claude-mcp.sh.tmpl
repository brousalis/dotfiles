{{ if and (ne .chezmoi.os "windows") .claude.mcpServers -}}
#!/bin/bash
# Adds the MCP servers listed in .chezmoidata/claude.yaml at user scope.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
command -v claude >/dev/null 2>&1 || exit 0
{{ range .claude.mcpServers -}}
claude mcp get {{ .name | quote }} >/dev/null 2>&1 || claude mcp add --scope user {{ .name | quote }} -- {{ .command }}
{{ end -}}
{{ end -}}
