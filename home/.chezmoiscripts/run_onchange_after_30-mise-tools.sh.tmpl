{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
# Installs the runtimes in ~/.config/mise/config.toml.
# config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [ -x "$brew" ] && eval "$("$brew" shellenv)" && break
done
if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found on PATH; the package step probably failed. Fix it and run chezmoi apply again." >&2
  exit 1
fi
mise install --yes
{{ end -}}
